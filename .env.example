APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql://ops_investigator:change-me@ops-investigator-postgres:5432/ops_investigator

ZABBIX_WEBHOOK_SECRET=change-me

CHATWOOT_ENABLED=false
CHATWOOT_URL=https://chatwoot.example.com
CHATWOOT_API_TOKEN=change-me
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_OPERATIONS_CONVERSATION_ID=1
CHATWOOT_MAX_ATTEMPTS=3
CHATWOOT_RETRY_BASE_DELAY_SECONDS=0.5

OPENAI_API_KEY=change-me
OPENAI_MODEL=choose-a-model
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_MAX_EVIDENCE_ITEMS=20

LOKI_URL=http://change-me:3100
LOKI_BEARER_TOKEN=
LOKI_TENANT_ID=
# Use the Zabbix host name as the key. Keep the actual host name only in .env.
LOKI_QUERIES_BY_SERVICE='{"your-zabbix-host":"{service=~\"bridge|chatwoot|chatwoot-worker\"}"}'
LOKI_TIMEOUT_SECONDS=10
LOKI_WINDOW_BEFORE_MINUTES=15
LOKI_WINDOW_AFTER_MINUTES=15
LOKI_QUERY_LIMIT=100
